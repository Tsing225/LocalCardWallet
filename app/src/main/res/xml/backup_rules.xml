<?xml version="1.0" encoding="utf-8"?>
<!--
  卡包数据绝不参与系统备份：数据库、配置（含密钥密文与密码哈希）、封面照片
  都只留在本机。配合 allowBackup="false" 使用，本文件是双保险
  （覆盖旧版本 Android 的 full-backup 行为）。
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
