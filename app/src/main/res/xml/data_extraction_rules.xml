<?xml version="1.0" encoding="utf-8"?>
<!--
  卡包数据不参与云备份与换机迁移：Keystore 里的数据库密钥
  本来就无法随备份迁移，备份了数据库也打不开；且备份会把
  加密库与密码哈希带出本机，违背"数据只留本机"的承诺。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
